    // ==========================

    fun actualizar(evento: Evento): Int {

        val db = dbHelper.writableDatabase

        val values = ContentValues().apply {

            put(
                DBHelper.COL_ID_USUARIO,
                evento.idUsuario
            )

            put(
                DBHelper.COL_ID_CLIENTE,
                evento.idCliente
            )

            put(
                DBHelper.COL_TITULO,
                evento.titulo
            )

            put(
                DBHelper.COL_DESCRIPCION,
                evento.descripcion
            )

            put(
                DBHelper.COL_FECHA,
                evento.fecha
            )

            put(
                DBHelper.COL_HORA,
                evento.hora
            )

            put(
                DBHelper.COL_LUGAR,
                evento.lugar
            )

            put(
                DBHelper.COL_CATEGORIA,
                evento.categoria
            )

            put(
                DBHelper.COL_ESTADO,
                evento.estado
            )
        }

        val resultado = db.update(
            DBHelper.TABLE_EVENTO,
            values,
            "${DBHelper.COL_ID_EVENTO}=?",
            arrayOf(evento.idEvento.toString())
        )

        db.close()

        return resultado
    }


    // ==========================
    // CONSULTA JOIN EVENTO COMPLETO
    // USUARIO + CLIENTE + PROVEEDORES
    // ==========================

    fun obtenerEventosCompletos(): MutableList<Map<String, String>> {

        val lista = mutableListOf<Map<String, String>>()

        val db = dbHelper.readableDatabase

        val consulta = """
            SELECT
                e.titulo,
                e.fecha,
                e.hora,
                e.lugar,
                u.nombres AS usuario,
                c.nombre AS cliente,
                p.nombre AS proveedor
            FROM Evento e
            INNER JOIN Usuario u
                ON e.idUsuario = u.idUsuario
            INNER JOIN Cliente c
                ON e.idCliente = c.idCliente
            INNER JOIN Evento_Proveedor ep
                ON e.idEvento = ep.idEvento
            INNER JOIN Proveedor p
                ON ep.idProveedor = p.idProveedor
        """.trimIndent()

        val cursor = db.rawQuery(
            consulta,
            null
        )

        if (cursor.moveToFirst()) {

            do {

                val fila = mapOf(

                    "titulo" to cursor.getString(0),

                    "fecha" to cursor.getString(1),

                    "hora" to cursor.getString(2),

                    "lugar" to cursor.getString(3),

                    "usuario" to cursor.getString(4),

                    "cliente" to cursor.getString(5),

                    "proveedor" to cursor.getString(6)
                )

                lista.add(fila)

            } while (cursor.moveToNext())
        }

        cursor.close()
        db.close()

        return lista
    }


    // ==========================
    // ELIMINAR EVENTO
    // ==========================

    fun eliminar(idEvento: Int): Int {

        val db = dbHelper.writableDatabase

        val resultado = db.delete(
            DBHelper.TABLE_EVENTO,
            "${DBHelper.COL_ID_EVENTO}=?",
            arrayOf(idEvento.toString())
        )

        db.close()

        return resultado
    }
