                    descripcion = cursor.getString(
                        cursor.getColumnIndexOrThrow(
                            DBHelper.COL_DESCRIPCION
                        )
                    ),

                    fecha = cursor.getString(
                        cursor.getColumnIndexOrThrow(
                            DBHelper.COL_FECHA
                        )
                    ),

                    hora = cursor.getString(
                        cursor.getColumnIndexOrThrow(
                            DBHelper.COL_HORA
                        )
                    ),

                    lugar = cursor.getString(
                        cursor.getColumnIndexOrThrow(
                            DBHelper.COL_LUGAR
                        )
                    ),

                    categoria = cursor.getString(
                        cursor.getColumnIndexOrThrow(
                            DBHelper.COL_CATEGORIA
                        )
                    ),

                    estado = cursor.getString(
                        cursor.getColumnIndexOrThrow(
                            DBHelper.COL_ESTADO
                        )
                    )
                )

                lista.add(evento)

            } while (cursor.moveToNext())
        }

        cursor.close()
        db.close()

        return lista
